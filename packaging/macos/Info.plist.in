<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>DeckCraft</string>
  <key>CFBundleName</key>
  <string>DeckCraft</string>
  <key>CFBundleExecutable</key>
  <string>DeckCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.deckcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>DeckCraftVersion</key>
  <string>@VERSION@</string>
  <key>DeckCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>DeckCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the DeckCraft authors. MIT OR Apache-2.0.</string>

  <!-- DeckCraft's own format: a zip of a JSON manifest plus media. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.deckcraft.presentation</string>
      <key>UTTypeDescription</key>
      <string>DeckCraft Presentation</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>DeckCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>deckcraft</string><string>slidecraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-deckcraft</string></array>
      </dict>
    </dict>
  </array>
  <!-- Open XML presentations; the system's own declaration wins when it has one. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.openxmlformats.presentationml.presentation</string>
      <key>UTTypeDescription</key>
      <string>Open XML Presentation</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>pptx</string></array>
      </dict>
    </dict>
  </array>

  <!-- What Finder may open with DeckCraft (double-click, Open With, default app). Without these
       AppKit refuses the 'odoc' event with "DeckCraft cannot open files in the … format";
       apple_events.rs hands the paths to the app. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>DeckCraft Presentation</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array><string>ai.storyteller.deckcraft.presentation</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>deckcraft</string><string>slidecraft</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Presentation</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.openxmlformats.presentationml.presentation</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>pptx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.presentation</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Template</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.openxmlformats.presentationml.template</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>potx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.template</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Show</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.openxmlformats.presentationml.slideshow</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>ppsx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.slideshow</string></array>
    </dict>
  </array>

</dict>
</plist>

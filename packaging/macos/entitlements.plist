<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for DeckCraft. The app is pure Rust, loads no unsigned code,
     needs no JIT, and is not sandboxed (it opens files by path, from the command line and
     drag-and-drop), so only the camera entitlement is listed: it takes effect if DeckCraft is ever
     sandboxed, and camera access today is granted by TCC together with NSCameraUsageDescription
     in Info.plist. Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- The Cameo live preview and camera slide shows. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
